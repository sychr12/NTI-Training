# Copie para .env (na mesma pasta do compose.yaml) só se quiser mudar algo. Sem .env, valem os padrões abaixo.

# Portas no seu computador. Se mudar a do backend, rode "docker compose up --build" de novo.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Usuário e senha do PostgreSQL do container
DB_USER=nti
DB_PASSWORD=nti

# "dev" = usuário local dev / dev123 e conteúdo de exemplo (fora da rede do AD).
# "default" = login pelo Active Directory (precisa estar na rede do IDAM).
NTI_PERFIL=dev

# Active Directory (usado só com NTI_PERFIL=default)
NTI_AD_URL=ldap://10.46.1.2:389
NTI_AD_DOMAIN=idam.am.gov.br
NTI_AD_BASE_DN=DC=idam,DC=am,DC=gov,DC=br
NTI_AD_ALLOWED_GROUPS=GTI,GTI_ESTAGIARIO
NTI_AD_ALLOW_INSECURE_LDAP=false
